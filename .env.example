# Backend origin, without /api and without trailing slash. Required for production builds (https only).
VITE_API_BASE_URL=https://api.example.com
# Optional: dev server host (localhost by default; "true" to expose on the local network)
VITE_DEV_SERVER_HOST=
# Optional: dev server port (3030 by default)
VITE_DEV_SERVER_PORT=
